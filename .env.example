# HRM Frontend Environment Configuration
# API Base URL pointing to deployed Laravel 13 backend on Vercel
NEXT_PUBLIC_API_URL=https://hrm-php-backend-indol.vercel.app/api/v1

# Application branding
NEXT_PUBLIC_APP_NAME="HRM Platform"

# Keep demo account shortcuts and persona controls hidden in production.
NEXT_PUBLIC_ENABLE_DEMO_PREVIEWS=false
